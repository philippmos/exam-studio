# Copy this file to `.env` and adjust for local development.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://exam:exam@localhost:5432/examstudio
# Comma separated list of allowed CORS origins (Angular dev server by default).
CORS_ORIGINS=http://localhost:4200
# Serve the in-browser GraphQL IDE and keep schema introspection on (dev only).
DEBUG=false

# --- Auth0 (OAuth2 resource server) -----------------------------------------
# The API rejects every /graphql request with HTTP 401 until these are set.
# See docs/auth0-setup.md.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# --- Media storage (question images) ----------------------------------------
# Run Azurite locally (`docker compose up -d azurite`). With uvicorn on the host,
# both the API and the browser reach Azurite on localhost:10000, so the browser
# base can be left empty (the connection string's BlobEndpoint host is used). In
# Azure, leave the connection string empty and set AZURE_STORAGE_ACCOUNT_URL so
# the managed identity is used instead.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=question-media
MEDIA_PUBLIC_BASE_URL=

# --- Observability (all optional; sensible defaults) ------------------------
LOG_LEVEL=INFO
# JSON logs for production; set to false for a coloured console renderer in dev.
LOG_JSON=true
# Deployment tag reported in logs, traces and Sentry.
ENVIRONMENT=development
# Expose Prometheus metrics at /metrics.
METRICS_ENABLED=true
# OTLP/HTTP endpoint for traces, e.g. http://otel-collector:4318. Empty = off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sentry DSN for error reporting. Empty = off.
SENTRY_DSN=
