# Database Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Api Configuration
CORS_ORIGINS=

# Auth0 / OAuth2 — shared by the API (OAuth2 resource server) and the SPA
# client. See docs/auth0-setup.md.
# AUTH0_DOMAIN:    your tenant domain, e.g. your-tenant.eu.auth0.com (no scheme/slash)
# AUTH0_AUDIENCE:  the API identifier from Auth0, e.g. https://api.exam-studio
# AUTH0_CLIENT_ID: the SPA application's Client ID (client only)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=

GRAPHQL_URL=/graphql

# --- Media storage (question images) ----------------------------------------
# Local dev uses the bundled Azurite emulator (see docker-compose.yml). The api
# reaches it over the compose network at http://azurite:10000; the browser loads
# signed image URLs via the published host port, so they are rewritten to
# MEDIA_PUBLIC_BASE_URL. The key below is Azurite's well-known dev key — replace
# the whole stack with a real Azure Storage account + managed identity in prod
# (set AZURE_STORAGE_ACCOUNT_URL instead and leave the connection string empty).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER=question-media
MEDIA_PUBLIC_BASE_URL=http://localhost:10000/devstoreaccount1